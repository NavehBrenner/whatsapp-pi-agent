# Local-only scratch and context. Never committed, never leaves this machine.
# See AGENTS.md — holds things like the Linear project link and Pi connection
# details that a new session needs but a public repo must not carry.
.local/

# secrets and live config
config/config.toml
*.env
.env*
!.env.example

# anything pulled off the device — real message content, never commit
data/
*.db
*.db-wal
*.db-shm
*.crypt14
snapshots/

# signal-cli state (contains account keys)
signal-data/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# android
android/**/build/
android/**/.gradle/
*.apk
*.keystore
local.properties

# editors / os
.idea/
.vscode/
.DS_Store

# Claude Code local state (worktrees, session scratch)
.claude/
