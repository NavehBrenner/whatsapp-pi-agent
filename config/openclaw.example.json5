// Copy to ~/.openclaw/openclaw.json on the Pi and fill in the uuids.
//
// VALIDATED against `openclaw config schema` (OpenClaw 2026.7.1-2, re-checked
// 2026-08-14 for the ADR 0012 runtime switch) with `openclaw config validate`.
// Do not hand-edit a key you have not seen in the schema —
// the prose docs are stale in at least three places and were wrong here before this
// file was checked (NVB-20 phase 0.1). To re-check after an OpenClaw upgrade:
//
//     openclaw config schema | less          # ground truth
//     openclaw config validate               # checks ~/.openclaw/openclaw.json
//
// OpenClaw reads JSON5 and WATCHES THE FILE — edits apply without a restart. That is
// convenient and it is also why `configWrites` is false below: a channel that can
// write this file is a chat message that grants a capability, which ADR 0010 forbids.
//
// Secrets do NOT go in here. Use ${VAR} substitution against ~/.openclaw/.env, and
// see docs/runbooks/04-agent-deploy.md.
//
// Every setting that differs from the OpenClaw default carries a "// WHY:" line.
{
  // -------------------------------------------------------------------------
  // The Signal channel.
  // -------------------------------------------------------------------------
  channels: {
    signal: {
      enabled: true,
      account: "+441234567890", // the assistant's own dedicated number (ADR 0004)

      // --- transport ------------------------------------------------------
      // There is no `transport` object. The docs describe "managed-native" /
      // "external-native" / "container"; the schema spells that as apiMode plus
      // autoStart plus the http* keys. apiMode is "auto" | "native" | "container".
      //
      // WHY native + autoStart:false — signal-cli stays under our own systemd unit
      // with --no-receive-stdout, --scrub-log and UMask=0007 (runbook 03). Letting
      // OpenClaw start its own daemon would lose those flags — message bodies into
      // journald, which is a standing invariant and not a preference — and
      // `--receive-mode on-connection`, without which a message arriving during a
      // gateway restart is acked to the server and never replayed. A managed daemon
      // may also bring its own binary and state path, and re-registration is the one
      // operation that can lose the number.
      //
      // It also brings its own uid, and since NVB-27 the daemon's uid is load-bearing
      // (it must be the gateway's, to read generated attachments).
      apiMode: "native",
      autoStart: false,
      // The daemon's JSON-RPC over HTTP, which is the only transport this plugin
      // speaks — wpa-gate uses the unix socket on the same daemon instead.
      //
      // ⚠️ A LOOPBACK PORT HAS NO OWNER CHECK. Until NVB-27 this was open to every
      // local uid with no credential: anyone with a shell could send as the
      // assistant and read the inbound stream. `wpa-signal-firewall.service` now
      // limits it to uid 0 and the gateway. If this port ever moves, that rule
      // moves with it in the same commit.
      httpHost: "127.0.0.1",
      httpPort: 8081,

      // --- who may talk to it ----------------------------------------------
      // WHY allowlist, not the "pairing" default (confirmed as the default in the
      // schema): pairing lets an unknown sender request their way in with a code.
      // An empty allowlist must mean "nobody", never "anyone who asks".
      dmPolicy: "allowlist",
      // KEY ON THE UUID. Verified on hardware 2026-08-11: Signal does not share
      // phone numbers by default, sourceNumber is null on real traffic, and an
      // E.164 entry matches nothing. Read the ACI off the wire — recipe in
      // config/example.config.toml.
      // Every principal with a 1:1 agent is listed here — a binding routes a DM, it
      // does not admit one. Omit a uuid and the DM is refused before any agent sees
      // it; add one with no binding and the DM falls through to `main`, which holds
      // nothing. Both fail closed, in opposite directions.
      //
      // ⚠️ NEITHER LOG WILL TELL YOU THE ACI OF SOMEONE WHO IS NOT LISTED YET, which
      // matters because "have them message it and read the id" is the obvious way to
      // onboard a person and it does not work. Measured 2026-08-14:
      //
      //   - the gate logs `dropped: sender (n total)` — a reason and a counter, no
      //     identifier. That is the "no message content in logs" invariant applying
      //     to the sender, and it is correct behaviour.
      //   - the gateway logs NOTHING AT ALL. Six refused DMs produced one unrelated
      //     line in twenty minutes. A `dmPolicy` refusal is silent at normal level.
      //
      // ⚠️ AND `listContacts` DOES NOT ANSWER IT EITHER. It returns address-book
      // contacts, not everyone the account knows: a person with a `recipient` row, an
      // `identity`, an open `session` and a fetched profile name was absent from it.
      // Do not read an empty result as "they never messaged".
      //
      // Two things that do work:
      //
      // 1. WITHOUT waiting for a message — resolve the number directly, one JSON-RPC
      //    line on /run/wpa-signal/socket. This is the cheap path, use it first:
      //      method "getUserStatus", params {recipient:["+447700900000"]}
      //        -> [{recipient, number, uuid, isRegistered}]
      //    It is a lookup against Signal's servers, so it tells Signal the assistant
      //    asked about that number.
      //    ⚠️ **THAT `uuid` IS NOT ALWAYS AN ACI.** For someone the account does not
      //    know yet it returns their **PNI** — the phone-number identity — in the same
      //    field, with nothing to distinguish it. Verified 2026-08-16: a number
      //    resolved to one uuid, and after that person joined a group the SAME CALL on
      //    the SAME NUMBER returned a different one. The first was the PNI.
      //    A PNI-keyed allowlist matches nothing on the wire and refuses in silence —
      //    the same failure as keying on a phone number, wearing a uuid's clothes.
      //    So step 1 is a lead, not an answer. Confirm before writing it down: the
      //    `aci` column in step 2, or membership in `listGroups`, which is ACIs only.
      // 2. AFTER they message — the daemon's own recipient store, which by then holds
      //    them. `aci` plus `profile_given_name`, and no message body is touched:
      //      SELECT aci, number, profile_given_name FROM recipient;
      //    in /var/lib/wpa-signal/data/<id>.d/account.db. **Snapshot `-wal` and
      //    `-shm` with it** and read the copy — the same rule as msgstore (ADR 0003),
      //    for the same reason, and this file IS the account. Cross-check against
      //    `identity` / `session`, which only ever hold real correspondents; the
      //    `recipient` table also carries PNI-only rows that never sent anything.
      //    The row holds BOTH ids — `aci` bare, `pni` with a literal `PNI:` prefix —
      //    which makes this the one place the two can be told apart by eye:
      //      SELECT aci, pni, number, profile_given_name FROM recipient WHERE number = …;
      //    Only the `aci` column goes in config. Delete the snapshot afterwards.
      //
      // The envelope tap in .local/pi.md answers it too and is the worst of the
      // three — it writes plaintext bodies to disk to learn one uuid.
      //
      // ⚠️ **A UUID ALONE IS NOT ENOUGH, AND THIS IS THE OPPOSITE OF THE GATE'S RULE.**
      // Read from the shipped plugin, 2026-08-19: `resolveSignalSender` checks
      // `sourceNumber` FIRST and only falls back to `sourceUuid`, and
      // `isSignalSenderAllowed` then compares kind-to-kind — a `phone` sender against
      // a `uuid` entry returns false, never a match. So a sender who shares their
      // phone number is refused by a uuid-only allowlist, **in silence**: no journal
      // line, no entry in the gateway's own log file, nothing.
      //
      // Whether a number is shared is the SENDER's privacy setting, not ours, and it
      // can change without notice — so list BOTH forms for every DM principal and
      // give each its own binding (`resolveSignalPeerId` returns the same phone form,
      // so routing misses too and the DM silently lands on the default agent).
      //
      // Cost it honestly: a phone entry is a weaker identity than an ACI — numbers get
      // recycled, ACIs do not — so this is two keys for one principal, not a better
      // key. It is what the plugin's precedence forces, and the uuid entry is what
      // keeps working the day they stop sharing the number.
      allowFrom: [
        "uuid:00000000-0000-0000-0000-000000000000", // owner
        "uuid:11111111-1111-1111-1111-111111111111", // alice
        "+15550000001",                              // alice again — SAME principal.
          // Both forms, because which one arrives is her setting and not ours.
        "uuid:22222222-2222-2222-2222-222222222222", // bob
        "uuid:33333333-3333-3333-3333-333333333333", // carol
      ],

      groupPolicy: "allowlist", // schema default; stated on purpose
      // Senders permitted to command from inside an allowlisted group.
      //
      // THIS IS CHANNEL-WIDE, NOT PER GROUP. Confirmed against the schema: a Signal
      // group's own config carries only ingest/requireMention/tools/toolsBySender —
      // there is no per-group sender allowlist. So anyone listed here is admitted to
      // EVERY allowlisted group. That is ADR 0011's fifth gate responsibility and it
      // is why the proxy exists rather than being a nice-to-have.
      // ⚠️ NOT THE SAME LIST AS `allowFrom`. Having a 1:1 agent does not admit someone
      // to the shared room, and being in the room does not give them a 1:1 agent:
      // these are two grants and a person can hold either, or both. Only people
      // actually in the family group belong here — adding a DM principal "for
      // consistency" admits them to EVERY allowlisted group, because this list is
      // channel-wide.
      //
      // The `carol` entry appears in both lists on purpose: they are a member of the
      // room AND have their own 1:1 agent. Those two facts are independent, and the
      // second was added months after the first.
      groupAllowFrom: [
        "uuid:00000000-0000-0000-0000-000000000000", // owner
        "uuid:33333333-3333-3333-3333-333333333333", // carol — also a DM principal
      ],

      // --- per-room grants (ADR 0008's pair, the half config can express) ----
      // Resolution: group toolsBySender -> group tools -> default toolsBySender ->
      // default tools. Deny wins. Each entry takes allow | alsoAllow | deny.
      groups: {
        "<base64 groupId from listGroups>": {
          // WHY true by default: in a shared room everything the assistant says is
          // disclosed to everyone present, so being addressed should be explicit.
          //
          // ⚠️ THE LIVE FAMILY ROOM RUNS `false`, DELIBERATELY. That room exists only
          // to talk to the assistant — every message in it is addressed to it — so a
          // mention requirement is friction with no disclosure benefit. Turn it back
          // on the moment the room is used for anything else, and note that the switch
          // is not free: read the paragraph below before assuming a mention works the
          // way it looks.
          //
          // ⚠️ "MENTION" HERE MEANS THE AGENT'S `identity.name` AS LITERAL TEXT, and on
          // 2026.7.1-2 a native Signal mention DOES NOT COUNT.
          //
          // Signal sends a mention as U+FFFC in the body plus a `mentions` array. The
          // plugin does substitute it — `renderSignalMentions` replaces the placeholder
          // with `@<uuid>`, the target's ACI, NOT their name. Gating then matches
          // `\b@?<identity.name>\b` (flag "i", from `deriveMentionPatterns`) against
          // that text, and `@b0c72586-…` contains no "Pi". So the mention is read and
          // then fails to match, which is not the same as being ignored.
          //
          // So with `identity.name: "Pi"`, typing `@Pi …` works and tapping the
          // assistant in Signal's mention picker does nothing. Note also that the
          // trigger is then the WORD "pi" in any casing — looser than "mention" reads.
          //
          // Fixed upstream in the 2026.7.2 beta (`resolveSignalMentionFacts` compares
          // each mention against the bot's own account); absent from 2026.7.1-2 and
          // 2026.6.34. Until we upgrade, `groupChat.mentionPatterns` can carry a
          // pattern matching our own ACI — but it REPLACES the identity-derived
          // patterns rather than extending them, so it must list both. NVB-30.
          //
          // And the miss is silent: it logs `reason: "no mention"` at VERBOSE only, so
          // at a normal log level the gate says `accepted` and the gateway says
          // nothing whatsoever. Verified on hardware 2026-08-14.
          requireMention: true,
          // The room's ceiling — nobody in it gets more than this.
          // An {allow|alsoAllow|deny} object, NOT the bare array the docs show.
          //
          // ⚠️ THIS CEILING IS WHAT THE AGENT ACTUALLY GETS IN THE ROOM, and it is
          // easy to set once and forget. It sat at `["session_status"]` after the
          // ADR 0012 switch, which meant the family agent had durable memory
          // everywhere except the one place it is actually used — a message in the
          // group resolved to a single read-only tool, so it could not write
          // MEMORY.md at all. The agent-level policy looked correct throughout;
          // only a probe against the real group session key showed it.
          //
          // The memory path, plus session_status, plus web_search. No exec — denied
          // globally too, and belt-and-braces is right for the shared room. Anything
          // outward-facing gets added one at a time, each answering "what does a
          // successful injection do with this?"
          //
          // `group:plugins` is here because the media and search tools are backed by
          // the xAI plugin: without it the provider never registers and they silently
          // do not exist.
          //
          // `web_search` is the one content-ingestion path open, and it is worth being
          // clear about what it costs — search results are attacker-influenceable text
          // entering the context of an agent that now has durable memory, so a poisoned
          // result can persist past the turn. Acceptable today because there is nothing
          // outbound to pivot to and no WhatsApp write path; revisit when NVB-17/18 add
          // real tools, and make it the injection smoke test's first target.
          //
          // `image_generate` / `video_generate` are here because a family room is
          // most of the point of them. Judged the same way as everything else: a
          // successful injection cannot choose a RECIPIENT with these — the reply
          // goes to the room the turn came from — so the blast radius is burnt quota
          // and unwanted imagery in a room that can already see everything the
          // assistant says. That is an annoyance, not a disclosure.
          tools: {
            allow: [
              "session_status", "read", "write", "edit", "apply_patch",
              "group:plugins", "web_search",
              "image_generate", "video_generate",
            ],
          },

          // ⛔ STILL NO toolsBySender HERE — but the reason has changed, and the
          // change has NOT been re-verified on hardware. Do not add one on the
          // strength of this comment alone.
          //
          // The original finding (2026-08-12, by instrumenting
          // matchToolsBySenderPolicy): it resolves on the dispatch path, but a
          // CLI-backed agent is served over the MCP loopback, whose context is
          // rebuilt from HTTP headers that carry no sender. The deciding call saw no
          // identity, fell through to "*", and any per-sender rule was silently
          // inert — the dangerous kind of inert, since a narrowing rule that never
          // matches fails OPEN.
          //
          // ADR 0012 removed the CLI backend, so the loopback bridge is no longer in
          // that path and the premise of that finding no longer holds. What it does
          // NOT establish is that toolsBySender now works: nobody has re-run the
          // instrumentation on the built-in runtime. Until someone does (NVB-21),
          // everyone in a room shares ONE tool set — the `tools` line above — and
          // that is a deliberate ceiling rather than an unknown.
          //
          // Also note the beta rollback recorded here previously is moot:
          // v2026.7.2-beta.7 dropped `agents.defaults.cliBackends`, which was a
          // blocker only while we depended on that block. We no longer do.
        },
      },

      dms: {
        // The only supported per-DM key. Everything else about a DM is decided by
        // which agent its binding routes to — in particular there is NO per-DM
        // `tools`, so a 1:1 agent's capability is its own agent entry plus the global
        // policy, and nothing narrows it here.
        "uuid:00000000-0000-0000-0000-000000000000": { historyLimit: 50 },
        "uuid:11111111-1111-1111-1111-111111111111": { historyLimit: 50 },
        "uuid:22222222-2222-2222-2222-222222222222": { historyLimit: 50 },
        "uuid:33333333-3333-3333-3333-333333333333": { historyLimit: 50 },
      },

      // WHY false: "no message may grant a capability" (ADR 0010) as a config key.
      // With hot reload on, a channel that can write config is a
      // privilege-escalation path reachable by prompt injection.
      configWrites: false,

      // Reactions on the assistant's own messages — which is the approval path.
      // "all" would surface reactions on other people's messages too.
      reactionNotifications: "own",

      // Inbound attachments. `true` until 2026-08-15, when it turned out to be why the
      // assistant never reacted to a photo: signal-cli receives and stores the file
      // fine (`/var/lib/wpa-signal/attachments/`, verified on a real send), and the
      // CHANNEL discards it before any agent sees it. Nothing logs that.
      //
      // Now false, and judged the way every ingestion path here is judged — "what does
      // a successful injection do with this?" An image is attacker-influenceable
      // content entering the context of an agent that has durable memory, so a photo
      // carrying instructional text is the same shape of risk as a poisoned
      // `web_search` result, which this config already accepts and for the same reason:
      // there is nothing outbound to pivot to and no WhatsApp write path. It is a
      // wider surface than search though — a person can be talked into forwarding a
      // picture far more easily than into pasting a link.
      //
      // NOT a documented threat-model control before this: the ADRs' attachment
      // discussion is all about OUTBOUND generated media (0006, 0012). This was
      // hygiene, and it is now a decision.
      //
      // ⚠️ `mediaMaxMb` MATTERS NOW AND DID NOT BEFORE. With attachments ignored, an
      // unset cap was harmless; with them accepted it is the only bound on what a
      // sender can push into the context and onto the disk. The live config had no
      // value at all — the default is not this one.
      ignoreAttachments: false,
      mediaMaxMb: 8,
      sendReadReceipts: false, // WHY: a read receipt tells a stranger the number is live
    },
  },

  // -------------------------------------------------------------------------
  // Approvals (ADR 0008's confirmations, NVB-16).
  //
  // NOTE: there is no `channels.signal.execApprovals`. Only discord, matrix, qqbot,
  // slack and telegram have that block — Signal does not, so approvers are inferred
  // from channels.signal.allowFrom / defaultTo (and commands.ownerAllowFrom) and
  // delivery is configured here instead.
  //
  // On Signal these render as 👍 (allow once) / 👎 (deny) reactions on the prompt,
  // and an ask_user prompt with 2-4 options as 1️⃣-4️⃣. The reaction is bound to that
  // request id — a stronger link between a YES and the action it authorises than the
  // quoted reply we designed. VERIFY on hardware (NVB-20 phase 3.3).
  // -------------------------------------------------------------------------
  approvals: {
    exec: {
      enabled: true, // WHY: default is false, and then nothing is ever asked
      // WHY targets, not session: an approval prompt in the family group is
      // answerable by a reaction from anyone in the room, and read by all of them.
      mode: "targets",
      targets: [{ channel: "signal", to: "uuid:00000000-0000-0000-0000-000000000000" }],
    },
    // ⚠️ THESE TARGETS ARE THE OWNER ONLY, AND STAY THAT WAY NOW THAT OTHER PEOPLE
    // HAVE AGENTS. A prompt raised inside a family member's own DM is answered by the
    // owner, not by them: the approval exists because the action needs a judgement,
    // and the person whose message triggered it is the one an injection is speaking
    // through. It does mean an approval in a family DM is answered out of band, which
    // is friction on purpose.
    plugin: {
      enabled: true, // independent of approvals.exec.enabled
      mode: "targets",
      targets: [{ channel: "signal", to: "uuid:00000000-0000-0000-0000-000000000000" }],
    },
  },

  // -------------------------------------------------------------------------
  // Sessions. WHY both keys: dmScope alone leaves group sessions shared.
  // -------------------------------------------------------------------------
  session: {
    // WHY not the "main" default: main collapses every DM on every channel into one
    // session. ADR 0010 rule 1 — an agent session may not span conversations.
    dmScope: "per-channel-peer",
    scope: "per-sender",
  },

  // -------------------------------------------------------------------------
  // Model auth. NOT set here — credentials never live in this file.
  //
  // xAI OAuth, per agent, and the provider choice is an ISOLATION decision rather
  // than a billing or quality one (ADR 0012). The rule it comes from:
  //
  //     the runtime is the one the sandbox can reach.
  //
  // Anthropic cannot satisfy that. For Anthropic, OAuth *is* Claude CLI reuse, the
  // CLI runs as a host subprocess beside the gateway, and OpenClaw's sandbox never
  // touches it — so subscription auth and sandbox coverage are structurally
  // exclusive there. Providers with OpenClaw-managed OAuth and NO registered
  // harness — xAI/Grok, Qwen — run on the built-in runtime, where the sandbox
  // applies. That is the whole reason this file says xai.
  //
  //     openclaw models auth --agent <id> login --provider xai --method oauth
  //
  // Note the flag order: `--agent` is an option on `models auth`, so it comes
  // BEFORE the `login` subcommand. Put it after and OpenClaw rejects it outright.
  // The flow is device-code (no localhost callback) and REQUIRES AN INTERACTIVE
  // TTY — there is no form a generator can emit, unlike the claude-cli pin this
  // replaces. xAI labels the consent app "Grok Build"; that is OpenClaw's shared
  // OAuth client, not a wrong app.
  //
  // EVERY AGENT NEEDS ITS OWN LOGIN. Credential read-through is two-tier — local
  // agentDir, then the default agent's store — and `main` is deliberately empty
  // (see agents.list below), so there is nothing to inherit. If one subscription
  // refuses several device-code logins, the narrow fix is to let `main` hold THE
  // MODEL CREDENTIAL ONLY: every agent needs inference, a shared subscription
  // under a provider-side cap is already accepted, and tool credentials — the part
  // that was ever load-bearing — stay out of main.
  //
  // SecretRefs cannot help here: an OAuth-mode auth profile combined with SecretRef
  // input fails activation.
  //
  // Fallbacks, if xAI OAuth is refused for this account: Qwen OAuth on the same
  // reasoning, or reopen ADR 0012. NOT an API key by default — that is a billing
  // decision wearing an isolation decision's clothes.
  //
  // NOT available, checked 2026-08-12: Google. Consumer Gemini CLI "Login with
  // Google" ended 2026-06-18 and Antigravity's terms prohibit third-party tools, so
  // OpenClaw will not create new Gemini OAuth profiles — a Google AI Pro subscription
  // buys nothing here. Cursor has no sanctioned third-party inference API at all.
  //
  // Whatever backs it, nothing caps spend. Set a billing or quota alert (ADR 0011).
  // -------------------------------------------------------------------------
  agents: {
    defaults: {
      // ⚠️ NOT the provider default. `XAI_DEFAULT_MODEL_ID` in dist is still
      // `grok-4.3`; this is a deliberate move to the newer frontier model.
      //
      // Check the ref against the catalog rather than typing it — and use `--all`,
      // because the bare `openclaw models list` shows only CONFIGURED models and will
      // convince you a model does not exist:
      //
      //     openclaw models list --all --provider xai
      //
      // ⚠️ `models list` REPORTS 4.5 AS `Input: text`. THAT METADATA IS WRONG.
      //
      // xAI documents Grok 4.5 as multimodal, and it was confirmed by hand on
      // 2026-08-15 to read images correctly. OpenClaw's catalog entry for it simply
      // has not caught up — which matters because OpenClaw ROUTES ON THE METADATA,
      // not on what the model can do. Believing 4.5 is text-only, it sends any turn
      // carrying an image to `agents.defaults.imageModel` instead.
      //
      // The consequence is live and measurable: since attachments were enabled, 16
      // turns went to grok-4.5 and exactly 1 to grok-4.3 — the one with a photo in it.
      // Images work, and they work on the older model. That is a functioning
      // workaround, not the intended arrangement.
      //
      // To put images back on 4.5, the fix is a corrected catalog entry under
      // `models.providers.xai.models` declaring its real `input`. NOT done here,
      // because writing that key overrides the plugin's own provider registration and
      // it is not established whether a `models` array EXTENDS the stock catalog or
      // REPLACES it — replacing it would silently take grok-imagine-* with it and kill
      // media generation. Establish that first; it is one scratch-config experiment
      // with OPENCLAW_CONFIG_PATH.
      //
      // The context figure moved too, and the listing has reported both 500k and 200k
      // for 4.5 on the same box. Do not treat any number in that column as load-bearing
      // without checking it against xAI's own documentation.
      //
      // Media GENERATION is unaffected — imageGenerationModel / videoGenerationModel
      // below are separate refs and stay on grok-imagine-*.
      model: { primary: "xai/grok-4.5" },

      // Vision, and it is a SEPARATE MODEL FROM THE BRAIN. The schema: imageModel is
      // "used when the primary model lacks image input".
      //
      // ⚠️ IT IS LOAD-BEARING FOR A REASON THAT IS NOT THE OBVIOUS ONE. grok-4.5 is
      // perfectly capable of reading images (see the note on `model` above); OpenClaw's
      // catalog just says otherwise, and OpenClaw routes on its catalog. So this line
      // exists to satisfy a wrong belief, and it works — image turns land on grok-4.3
      // and are answered correctly. Delete it and images stop working again, even
      // though the primary model could have handled them all along.
      //
      // Paired with channels.signal.ignoreAttachments as ONE decision. Either alone
      // does nothing:
      //   ignoreAttachments:false, no imageModel -> image arrives, nothing can read it
      //   imageModel set, ignoreAttachments:true -> nothing ever arrives
      // Both were wrong simultaneously until 2026-08-15, which is why "the agent
      // doesn't see photos" had two causes and no log line for either.
      imageModel: { primary: "xai/grok-4.3" },

      // Media generation, on the same xAI OAuth as everything else. Model ids read
      // out of dist; naming them is not optional — the tools only REGISTER when a
      // model resolves, and an unregistered tool is absent with no log line saying so.
      imageGenerationModel: { primary: "xai/grok-imagine-image" },
      videoGenerationModel: { primary: "xai/grok-imagine-video" },

      // ⚠️ THIS IS PART OF THE MEDIA SETTINGS, NOT A GENERAL TIMEOUT. Generation is
      // async and takes ~90s; the default run timeout cuts the completion run off
      // mid-flight, which trips an auth-profile cooldown that then breaks LATER,
      // unrelated turns. The symptom appears nowhere near the cause.
      timeoutSeconds: 600,

      // These three sat commented out until NVB-27, and the reason was never
      // capability — both tools always worked, generating correctly inside the
      // sandbox. What failed was the last hop: OpenClaw hands signal-cli a PATH
      // under ~/.openclaw/media/outbound and re-asserts 0700 on `media` on every
      // generation (measured — 0710 before a run, 0700 after), so no group grant
      // survives and a watcher would race it. signal-cli therefore has to BE the
      // gateway uid; it now is (runbook 03), which is a real narrowing of ADR 0006's
      // split and is recorded there rather than here.
      //
      //     Signal RPC -32603: Failed to send message: …/outbound/image-….jpg
      //       (Permission denied) (AttachmentInvalidException)
      //
      // ⛔ If signal-cli ever moves back to its own uid, DELETE THESE THREE KEYS in
      // the same commit — they would ship tools that always fail at the last step,
      // in a family group, after appearing to work.

      // ---------------------------------------------------------------------
      // THERE IS NO `cliBackends` BLOCK, AND ITS ABSENCE IS DELIBERATE.
      //
      // It used to hold a `--tools` floor under Claude Code's own Bash/Read/Write,
      // because OpenClaw's tools.* policy did not touch them — measured on hardware
      // 2026-08-12, where the agent ran `id` as a NOPASSWD:ALL user and read this
      // very config, reporting a plaintext gateway.auth.token out of it.
      //
      // That floor is gone because the thing it was propping up is gone. `cliBackends`
      // governs CLI backends only; on the built-in runtime there is no host
      // subprocess to floor. If you find yourself re-adding it, you have switched
      // back to a CLI runtime — go read ADR 0012 first, because the sandbox does not
      // reach one.
      //
      // The lesson that outlived the block: TOOL POLICY BINDS AT SESSION CREATION.
      // Tightening it leaves existing sessions on the old capability set until their
      // session store is cleared — a fresh agent had one tool while a resumed one
      // still had `Read`. Whatever regenerates this config must clear affected
      // sessions.
      // ---------------------------------------------------------------------

      sandbox: {
        // WHY "all", not the "off" default: the container IS the enforcement
        // (ADR 0010). Without it a tool is refused by name instead of being absent.
        //
        // This line only became true with ADR 0012. Under the previous claude-cli
        // pin it governed nothing that executed — OpenClaw sandboxes its own six
        // tools (read, write, edit, apply_patch, exec, process) and the CLI's
        // natives ran beside the gateway on the host regardless.
        mode: "all",
        scope: "agent", // one container per agent id (default, stated on purpose)
        backend: "docker", // the only other registered backend is "ssh"

        // MUST BE "rw". The three values are not shades of the same thing:
        //   none  (default) → tools see a THROWAWAY dir under ~/.openclaw/sandboxes,
        //                     so MEMORY.md is written and silently lost
        //   ro              → workspace at /agent, and write/edit/apply_patch are
        //                     DISABLED outright
        //   rw              → workspace at /workspace, read-write
        // The agent's own workspace is bind-mounted in: the sandbox does not cut the
        // agent off from its own files, it cuts it off from everything else. Durable
        // memory is the capability this whole ADR exists to restore, so "rw" it is.
        workspaceAccess: "rw",

        // Left at the default "spawned" on purpose. It force-clamps session
        // visibility to `tree` for sandboxed callers, which is what keeps
        // cross-agent messaging off even if tools.sessions.visibility says
        // otherwise. Cross-agent work is deferred (Q6); do not loosen this without
        // reading that section first.
        // sessionToolsVisibility: "spawned",

        docker: {
          image: "openclaw-sandbox:bookworm-slim", // the default; NOT auto-built

          // NVB-25. Reads like a privilege grant and is the opposite of one: the
          // daemon is ROOTLESS, so container uid 0 maps to the host's `openclaw`
          // uid — the gateway's own identity, and nothing more. Without it the
          // image's `sandbox` user (uid 1000) maps to an unrelated subuid, and the
          // workspace bind is writable in name only: `write` and `edit` fail with
          // EACCES, which reads as a broken tool rather than a mapping problem.
          // capDrop/readOnlyRoot/network still apply — this changes who the
          // container is, not what it may do.
          // If the daemon is ever rootful again, DELETE THIS LINE in the same
          // commit: there it means real root on a host bind mount.
          user: "0:0",

          // "none" is OpenClaw's own default for sandbox containers, stated here
          // because it is load-bearing rather than incidental: the agent's tool
          // calls that reach the network (calendar, mail) are made by the GATEWAY,
          // above the sandbox — the container needs no egress at all. The Pi's
          // daemon is rootless (NVB-25), so its networking lives in its own netns
          // and cannot reach the host's firewall or Waydroid's bridge either way.
          network: "none",

          readOnlyRoot: true,
          capDrop: ["ALL"],
          pidsLimit: 256,
          memory: "512m",
          // readOnlyRoot needs somewhere writable that is not the workspace.
          tmpfs: ["/tmp"],
        },
      },
    },
    // It is `agents.list` (an array of objects each carrying `id`), NOT the
    // `agents.entries` map the docs describe. `additionalProperties` is false on the
    // agents node, so `entries` is rejected outright rather than ignored.
    list: [
      {
        // THE DEFAULT AGENT HOLDS NOTHING. Auth stores have read-through
        // inheritance: an agent with no local profile resolves the default agent's
        // profiles at runtime, and there is no key to disable that. Keeping this one
        // empty is what makes "absent, not refused" still true — nothing can inherit
        // what does not exist.
        //
        // VERIFIED 2026-08-12, both directions. A canary key written ONLY here was
        // retrieved and sent upstream by `family`, which has no store file at all —
        // the provider answered 401, which is proof the key was found rather than
        // missing. Emptying this store then emptied family's view of it. This is not
        // a tidiness rule; it is the only thing standing between the agents until
        // sandbox.mode above is real (NVB-14).
        id: "main",
        default: true,
        tools: { deny: ["*"] },
      },
      {
        id: "owner",
        workspace: "~/.openclaw/workspaces/owner",
        // Credentials live in this agent's own agentDir. Never reuse an agentDir.
        //
        // THE AGENT'S NAME IS NOT SET HERE. `identity.name` is metadata for the UI;
        // what the assistant believes it is called comes from IDENTITY.md, a
        // bootstrap file in the agent's workspace. Set identity.name alone and the
        // agent answers "I don't have one yet — IDENTITY.md is still blank", which
        // is exactly what it did. Whatever generates agents must write that file.
        identity: { name: "Pi" },
      },
      {
        id: "family",
        workspace: "~/.openclaw/workspaces/family",
      },

      // A project room — one repo, one room, one agent. Same person as `owner` and
      // deliberately NOT the same agent: the gate refuses one agent in two
      // conversations, and here that refusal is the containment rather than a
      // formality. This room receives issue bodies and PR titles from PUBLIC repos
      // via a notifier, which is attacker-influenceable text arriving at an agent
      // with durable memory. A shared session would carry a poisoned issue into the
      // private chat; a shared workspace would persist it in the same MEMORY.md.
      //
      // Needs its OWN `openclaw models auth --agent code-invariants login`, and its
      // own IDENTITY.md written into the workspace. Skipping either is the `carol`
      // failure: it will appear to work by reading through to `main`, right up until
      // the day `main` is actually empty.
      // ⚠️ AN AGENT-LEVEL `tools.alsoAllow` REPLACES THE GLOBAL ONE. It does not
      // merge. Granting this agent the GitHub tools without repeating the global
      // names removed `read`, `write`, `edit` and `apply_patch` from it — including
      // its ability to write its own MEMORY.md — and nothing said so: the config
      // validated, the room's tools.allow ceiling still listed them, and the
      // tool-policy log reports removals per layer without reporting that a layer
      // was overridden. Repeat the global names in every per-agent list.
      // {
      //   id: "code-invariants",
      //   workspace: "~/.openclaw/workspaces/code-invariants",
      //   tools: {
      //     alsoAllow: [
      //       "read", "write", "edit", "apply_patch", "web_search",  // global set, repeated
      //       "github__issue_write", "github__add_issue_comment",
      //       "github__issue_read", "github__list_issues",
      //       "github__pull_request_review_write",      // formal reviews; see below
      //       "sessions_spawn", "subagents",
      //     ],
      //   },
      //   // Subagents inherit the parent's EFFECTIVE tool list, so the repetition
      //   // above is what makes them useful: a child gets read/write/edit/apply_patch
      //   // and can map the repo mirror. It does NOT inherit github__* (MCP tools are
      //   // non-inheritable) or the spawn tools (recursion guard), so it cannot post
      //   // to GitHub as the owner. `subagents` must also be removed from the global
      //   // tools.deny and added to tools.sandbox.tools.allow.
      // },
      //
      // `web_search` was added 2026-08-18 and needed TWO edits, which is the shape
      // worth remembering: the agent list above AND the room's tools.allow ceiling
      // below. The global policy already had it; the per-agent list overrode that,
      // and the ceiling would have stripped it anyway. Adding it in one place looks
      // correct, validates, and does nothing.
      //
      // The cost is the one the family room's comment already names, now arriving in
      // a room that holds a GitHub PAT: search results are attacker-influenceable
      // text entering an agent with durable memory AND write access to issues. It is
      // still egress-only — an injection reads a page it chose, it does not pick a
      // recipient — but this is the first path that pulls open-web text into a
      // session that can post. Make it the injection smoke test's first target here,
      // not only in the family room.

      // ---------------------------------------------------------------------
      // One agent per family member's 1:1 chat. THREE AGENTS, NOT ONE SHARED ONE,
      // and the reason is memory rather than tools: `session.dmScope` already gives
      // each peer its own session, but a workspace is per AGENT, so three DMs on one
      // agent would put three people's MEMORY.md in one directory that all three
      // sessions read. That is ADR 0010 rule 1 arriving by the back door.
      //
      // NO `tools` BLOCK ON ANY OF THEM, ON PURPOSE. They get the global policy,
      // which is the same surface `owner` has — read, write, edit, apply_patch,
      // session_status, web_search, image_generate, video_generate. `exec` is denied
      // globally, so "everything except exec" needs no per-agent line, and adding an
      // empty one would invite someone to widen it later without re-asking the
      // question every tool has to answer.
      //
      // Each needs its OWN `openclaw models auth --agent <id> login`. `main` is empty
      // by design, so there is nothing to inherit — an agent with no auth profile
      // fails at the first turn rather than falling back to somebody else's.
      //
      // ⚠️ THAT SENTENCE WAS FALSE ON THE PI FOR A DAY, and a NEW AGENT WORKING is how
      // it surfaced. `carol` was deployed 2026-08-15 with no login of their own and
      // answered on the first turn, because `main`'s store held an xai profile and
      // read-through found it:
      //
      //     xai effective=profiles:~/.openclaw/agents/main/agent/openclaw-agent.sqlite
      //
      // ⚠️ AND EMPTYING `main` IS NOT ENOUGH ON ITS OWN. Cleared by hand, it REFILLED
      // ITSELF within two minutes of ordinary use — no login was run, and the calling
      // agent's own store was untouched. What made the second attempt stick was giving
      // the one agent that lacked a profile one of its own; since then `main` has stayed
      // empty through idle, CLI reads, agent turns, a failing turn and a restart.
      //
      // So the rule that is actually actionable is the second one, not the first:
      //
      //     the default agent stays empty only while EVERY OTHER AGENT HAS ITS OWN
      //     PROFILE. An agent with none is not untidy, it is the cause.
      //
      // ⚠️ THAT RULE IS ALSO FALSE, and it was disproved the way it said it would be.
      // On 2026-08-16 `main` was found holding one profile again, written at
      // 2026-08-15 20:06 — twenty hours AFTER the last agent lacking one was given
      // its own (00:30), and hours BEFORE the next new agent existed. Every agent
      // held its own profile across that whole window. So an agent without a profile
      // is not the cause either; it was only the last thing changed before main
      // happened to stay empty for a day.
      //
      // Nothing about read-through is understood well enough to state a rule. What
      // is left is the check: run `deploy/check-agent-auth.sh` on a schedule, treat
      // a non-empty main as expected-to-recur rather than as a regression, and do
      // not mount a tool credential on the assumption that main is empty.
      //
      // Read-through is resolved at GATEWAY STARTUP, not per turn — main's contents at
      // boot are what decide, and repopulating it mid-run grants nothing until the next
      // restart. That is also why the failure is easy to miss: it arrives one restart
      // after the mistake.
      //
      // `deploy/check-agent-auth.sh` asserts both halves; run it after any login and
      // before any deploy. Nobody has identified what does the writing, so it detects
      // rather than prevents — and `openclaw models --agent <id> status` prints the
      // effective store path, which is the only place a misplaced credential shows up.
      // It is invisible from this file.
      //
      // And each needs an IDENTITY.md written into its workspace. `identity.name` is
      // UI metadata; the agent that has one without the other answers "I don't have a
      // name yet".
      // ---------------------------------------------------------------------
      // ⚠️ NAMES HERE ARE PLACEHOLDERS, AND SO ARE THE UUIDs. An entry is harmless only
      // while no binding and no `allowFrom` entry names it — an agent nothing routes to
      // is dead weight, whereas a binding on a placeholder uuid is a live rule matching
      // a real person's id somewhere in the world. Deploy one when its ACI is captured,
      // and do all four halves in the same edit: `allowFrom`, the agent entry, the
      // binding, and an IDENTITY.md in the workspace. `groupAllowFrom` is a FIFTH and
      // separate decision — it is channel-wide, so adding someone there admits them to
      // every allowlisted group, not just the one you had in mind.
      //
      // The live config carries two of these, and omits `workspace` because OpenClaw
      // derives `~/.openclaw/workspace-<id>` — which is what the box actually uses.
      // The explicit paths here are the documented shape, not the deployed one.
      {
        id: "alice",
        workspace: "~/.openclaw/workspaces/alice",
        identity: { name: "Pi" },
      },
      {
        id: "bob",
        workspace: "~/.openclaw/workspaces/bob",
        identity: { name: "Pi" },
      },
      {
        id: "carol",
        workspace: "~/.openclaw/workspaces/carol",
        identity: { name: "Pi" },
      },
      {
        // ADR 0010's mixed case: the owner's own session inside the shared room.
        // NOT expressible as a binding — bindings match per conversation, never per
        // sender — so this exists for the proxy to route to (ADR 0011 item 3).
        id: "owner-family",
        workspace: "~/.openclaw/workspaces/owner-family",
      },
    ],
  },

  // -------------------------------------------------------------------------
  // Which agent serves which conversation. Per conversation only.
  //
  // peer.kind is "direct" | "group" | "channel" | "dm", where "dm" is a deprecated
  // alias for "direct" — schema-confirmed, and the one thing the docs had no Signal
  // example for at all.
  //
  // **peer.id for a DIRECT peer carries the `uuid:` prefix; a GROUP id does not.**
  // Verified on hardware 2026-08-12. The canonical session key is the ground truth:
  //
  //     agent:owner:signal:direct:uuid:b0c72586-…      <- prefixed
  //     agent:family:signal:group:Mt2z3ANj…            <- not prefixed
  //
  // A bare uuid here does NOT match, and **nothing says so** — no error, no warning.
  // The conversation silently falls through to the default agent, which is why the
  // default agent holding nothing is load-bearing rather than tidy. Read the real key
  // out of ~/.openclaw/agents/<id>/sessions/sessions.json rather than typing one.
  // -------------------------------------------------------------------------
  bindings: [
    {
      agentId: "owner",
      match: {
        channel: "signal",
        peer: { kind: "direct", id: "uuid:00000000-0000-0000-0000-000000000000" },
      },
      comment: "owner-1to1",
    },
    {
      agentId: "family",
      match: {
        channel: "signal",
        peer: { kind: "group", id: "<base64 groupId>" },
      },
      comment: "family group — shared session, narrow tools",
    },
    // The project room. A GROUP id, so NO `uuid:` prefix — getting that wrong routes
    // the room to `main` in silence, which is the failure this file warns about above.
    // {
    //   agentId: "code-invariants",
    //   match: {
    //     channel: "signal",
    //     peer: { kind: "group", id: "<code-invariants base64 groupId>" },
    //   },
    //   comment: "code-invariants project room — owner only",
    // },
    // The three 1:1 chats. Note the `uuid:` prefix on every one — a bare uuid here
    // matches nothing, says nothing, and routes the DM to `main`.
    {
      agentId: "alice",
      match: {
        channel: "signal",
        peer: { kind: "direct", id: "uuid:11111111-1111-1111-1111-111111111111" },
      },
      comment: "alice-1to1",
    },
    // The SAME principal, in the phone form. Not a duplicate: the peer id comes from
    // `resolveSignalPeerId`, which returns the e164 whenever the envelope carried a
    // `sourceNumber` — so without this row her DM is admitted by `allowFrom` and then
    // routed to the DEFAULT agent, which is a worse failure than being refused: she
    // gets an answer, from an agent that is not hers and whose workspace is not hers.
    // Verified on hardware 2026-08-19; the live session key read
    // `agent:aviv:signal:direct:+9725…`, not `…:uuid:…`.
    {
      agentId: "alice",
      match: {
        channel: "signal",
        peer: { kind: "direct", id: "+15550000001" },
      },
      comment: "alice-1to1 — phone form of the same person",
    },
    {
      agentId: "bob",
      match: {
        channel: "signal",
        peer: { kind: "direct", id: "uuid:22222222-2222-2222-2222-222222222222" },
      },
      comment: "bob-1to1",
    },
    {
      agentId: "carol",
      match: {
        channel: "signal",
        peer: { kind: "direct", id: "uuid:33333333-3333-3333-3333-333333333333" },
      },
      comment: "carol-1to1",
    },
  ],

  // -------------------------------------------------------------------------
  // Tool policy. Narrow globally; each level can only restrict further, except
  // alsoAllow, which widens relative to the profile. Deny always wins.
  // -------------------------------------------------------------------------
  tools: {
    // `minimal` already removes 18 tools, observed on hardware 2026-08-12:
    //   agents_list, create_goal, cron, gateway, get_goal, message, nodes,
    //   sessions_history, sessions_list, sessions_send, sessions_spawn,
    //   sessions_yield, skill_workshop, subagents, tts, update_goal,
    //   web_fetch, web_search
    // So `message`, `gateway`, `nodes`, `cron`, `subagents` and the web tools need no
    // explicit deny — the ones below are the residue that `minimal` leaves behind.
    profile: "minimal",
    deny: [
      "exec", // no shell. Denying write/edit does NOT make exec read-only.
      "process",
      "terminal",
      // Denied even though ADR 0012 notes the xAI credential would power it for
      // free. Free is not the test; "what does a successful injection do with
      // this" is, and the answer for a code runner is the same as for a shell.
      "code_execution",
      "browser",
      "screen",
    ],

    // ⚠️ `minimal` STRIPS THE FILE TOOLS, SO THEY MUST BE ADDED BACK EXPLICITLY.
    //
    // Not denying them is not enough — verified on hardware 2026-08-14. With
    // `profile: "minimal"` and no `alsoAllow`, the agent's ENTIRE tool surface was
    // `session_status`: asked to write a file it neither wrote one nor errored, and
    // asked to list its tools it named only that one. `alsoAllow` widens relative to
    // the profile, which is the documented mechanism for exactly this.
    //
    // This one hid behind a stale observation. The note elsewhere in this file that
    // "minimal removes 18 tools" was measured on 2026-08-12 under claude-cli — where
    // read/write/edit/apply_patch were stripped from the loopback bridge by
    // NATIVE_TOOL_EXCLUDE regardless, so their absence from that list proved nothing
    // about the profile. Carrying that measurement across a runtime change is the
    // "TOOL NAMES ARE RUNTIME-DEPENDENT" trap below, sprung on us rather than by us.
    alsoAllow: [
      "read", "write", "edit", "apply_patch",
      "web_search",
      // NVB-27. Both are gateway-side, like web_search — the sandbox has no network
      // and never needed one for these.
      "image_generate", "video_generate",
    ],

    // ⚠️ AND THEY ARE NOT DENIED, ON PURPOSE.
    //
    // They are the memory path. Memory is plain Markdown in the agent workspace —
    // MEMORY.md, memory/YYYY-MM-DD.md — written with an ordinary file-write tool,
    // so denying the file tools means the agent cannot remember anything.
    // (`compaction.memoryFlush` does not rescue that: it is a silent agentic turn
    // that prompts the model to write, needing the very tool that would be absent.)
    //
    // What makes that safe is not this list — it is the sandbox above. These four
    // are OpenClaw's own tools, so they execute INSIDE the container, against a
    // workspace bind-mounted at /workspace. `write` accepting an absolute path is
    // harmless when the absolute path is inside a container that holds nothing
    // else. Under the old claude-cli pin the same tools ran on the host as the
    // gateway uid, which is why they were unusable there and why ADR 0012 is a
    // runtime change rather than a policy change.
    //
    // So: if sandbox.mode ever goes back to "off", these must be denied again in
    // the same commit. The two settings are one decision.

    elevated: { enabled: false }, // WHY: exec is denied; this closes the escape hatch

    // Provider-side search on the agent's own xAI OAuth — no separate key. `grok` is
    // a `web_search` provider that reuses an existing xAI OAuth sign-in.
    web: { search: { enabled: true, provider: "grok" } },

    // -----------------------------------------------------------------------
    // A SECOND, INDEPENDENT ALLOWLIST that applies only to sandboxed runs.
    //
    // Its default set is narrower than the global policy and excludes `web_search`,
    // so without this block the tool is stripped here after surviving everything
    // above. The gateway does say so: "tool policy removed 3 tool(s) via sandbox
    // tools.allow".
    //
    // ⚠️ `group:plugins` IS LOAD-BEARING AND ITS ABSENCE FAILS SILENTLY. An allowlist
    // built only from known core tool names resolves `includePluginTools` to false,
    // which drops the xAI plugin's PROVIDER registrations — and a tool whose provider
    // never registered does not appear, is not logged as removed, and raises no
    // error. It reads exactly like the sandbox suppressing it, and cost most of an
    // afternoon and one wrong conclusion in ADR 0012 (see the changelog).
    //
    // ⚠️ Use `allow`, NOT `alsoAllow` — AND NOTE THE ASYMMETRY, because it is the
    // whole trap. `pickSandboxToolPolicy` unions `alsoAllow` against a wildcard
    // (`["*", ...extra]` when no `allow` is set), so `alsoAllow` HERE silently means
    // "allow everything plus these".
    //
    // The top-level `tools.alsoAllow` above does the opposite and safe thing —
    // `mergeAlsoAllowPolicy` returns the policy UNCHANGED when there is no existing
    // allow list, and otherwise appends. Same key name, same file, opposite failure
    // direction. Checked in `dist` on 2026-08-14 because we depend on the top-level
    // one for the file tools and needed to know it was not quietly wildcarding.
    //
    sandbox: {
      tools: {
        allow: [
          "read", "write", "edit", "apply_patch",
          "session_status",
          "group:plugins",
          "web_search",
          "image_generate", "video_generate",
        ],
      },
    },
  },

  // -------------------------------------------------------------------------
  // TOOL NAMES ARE RUNTIME-DEPENDENT — the trap this config cannot express.
  //
  // This is why a runtime switch is never just a runtime switch: every allow and
  // deny above is a bet that the name still resolves. Observed 2026-08-12 under the
  // claude-cli runtime we have now left, and the shape of the warning is the part
  // that generalises, not the specific tool:
  //
  //   WARN group tools.allow allowlist contains unknown entries (read). These
  //   entries are shipped core tools but unavailable in the current
  //   runtime/provider/model/config.
  //
  // So a name that is valid under one runtime is simply absent under another, and an
  // allow list naming it grants nothing. A *deny* naming it is worse: it is silently
  // a no-op, and `openclaw config validate` passes either way (verified: a typo'd
  // "gatewayy" in a deny array validates clean).
  //
  // This is what the registry (src/agent/registry.py) is for, and it means the
  // registry has to be checked against THE RUNTIME WE ACTUALLY RUN rather than a
  // static list — ADR 0011.
  // -------------------------------------------------------------------------

  // -------------------------------------------------------------------------
  // `allow` IS A HARD ALLOWLIST OVER EVERY PLUGIN, STOCK ONES INCLUDED.
  //
  // Not just external ones, which is what we assumed until 2026-08-14. OpenClaw
  // ships ~68 stock plugins and each provider is one of them, so a provider absent
  // from this list cannot be enabled at all — `openclaw plugins enable xai` answers
  // "blocked by allowlist" and setting `entries.xai.enabled: true` alone does
  // nothing.
  //
  // ⚠️ The error that actually surfaces is worse than that one. `openclaw models
  // auth login --provider xai` reports:
  //
  //     Error: No provider plugins found. Install one via `openclaw plugins install`.
  //
  // The plugin IS installed — it is stock, it is right there in `plugins list` — it
  // is merely untrusted. Following that advice would have you installing something
  // you already have. `plugins list` shows the truth ("N/68 enabled" plus a
  // per-plugin status column); trust it over the error text.
  //
  // Compounding it: the gateway AUTO-ENABLES the provider plugin for whatever model
  // is configured, logging "enabled automatically ... without writing config". So
  // the running gateway can be perfectly happy on a provider the CLI swears is not
  // installed. Config is what the CLI reads; the auto-enable is runtime-only.
  //
  // The Signal channel is here for the original reason, which still holds: it is an
  // EXTERNAL plugin and is not trusted implicitly. With neither key, the gateway
  // starts, logs one WARN ("channel is configured, but external plugin \"signal\" is
  // installed without explicit trust"), and then simply never connects — no error,
  // no retry, no clue at the channel level. Found by reading the gateway log on
  // 2026-08-12.
  //
  // It is a good default on their part: a plugin that can see every message, or
  // hold every credential, should not load because some other block mentions it.
  // -------------------------------------------------------------------------
  plugins: {
    allow: ["signal", "xai"],
    entries: {
      signal: { enabled: true },
      xai: { enabled: true }, // the model provider (ADR 0012)
    },
  },

  // -------------------------------------------------------------------------
  // THE PIN IS THE POINT (ADR 0012).
  //
  // `agentRuntime.id` defaults to "auto", and auto PREFERS A REGISTERED HARNESS
  // when one supports the provider. Registered harness ids are codex, claude-cli,
  // github-copilot and google-gemini-cli; the built-in runtime is "openclaw". So
  // leaving this at auto is not a neutral choice — install a CLI that claims the
  // provider and the runtime silently moves out from under the sandbox.
  //
  // xAI has no registered harness today, so auto would resolve to "openclaw"
  // anyway. Pin it regardless: this config should express which runtime we require,
  // not which one we happen to get.
  //
  // The question to ask of any future runtime change, before any other question:
  // DOES THE SANDBOX REACH THE TOOLS THAT ACTUALLY EXECUTE? No amount of tool
  // policy above it substitutes.
  // -------------------------------------------------------------------------
  // ⚠️ `baseUrl` IS NOT OPTIONAL HERE, AND OMITTING IT FAILS IN THE WORST WAY.
  //
  // The xai plugin defines `XAI_BASE_URL = "https://api.x.ai/v1"` itself, so this
  // line looks redundant. It is not: writing a `models.providers.xai` entry at all
  // OVERRIDES the plugin's provider registration, and an entry carrying only
  // `agentRuntime` overrides it with one that has no base URL.
  //
  // What happens then is not an error. The request falls back to the default
  // OpenAI endpoint and OpenClaw cheerfully POSTs the xAI OAuth token to
  // https://api.openai.com/v1/responses, which answers:
  //
  //     401 Your authentication token is not from a valid issuer.  (code=invalid_issuer)
  //
  // That reads as "xAI rejected your login" and sends you back to re-run the OAuth
  // flow, which is the one thing that was never broken. The tell is in the gateway
  // log — `[model-fetch] start provider=xai ... url=https://api.openai.com/...`.
  // Check the URL before you touch the credentials.
  //
  // Verified on hardware 2026-08-14: adding this line moved the request to
  // api.x.ai/v1/responses on the next restart, with no other change.
  models: {
    providers: {
      xai: {
        agentRuntime: { id: "openclaw" },
        baseUrl: "https://api.x.ai/v1",
      },
    },
  },

  gateway: {
    auth: {
      rateLimit: { maxAttempts: 10, windowMs: 60000, lockoutMs: 300000, exemptLoopback: true },
    },
  },
}
