#!/usr/bin/env bash
# Apply a host-written grant intent to live openclaw.json.
#
# Installed as /usr/local/bin/wpa-grant-apply. **No arguments.** openclaw may
# invoke it via NOPASSWD sudo (deploy/sudoers.d/wpa-openclaw). NVB-103.
#
# Sequence (fixed): re-read intent → validate working copy → backup live →
# atomic install. Never restarts the gateway.
#
# Exit 2 = validation failed before mutation. Exit 1 = failure. Exit 0 = done.
set -euo pipefail

[ "$(id -u)" = 0 ] || { echo "wpa-grant-apply: must run as root" >&2; exit 2; }

venv="${WPA_VENV_PYTHON:-/opt/wpa/.venv/bin/python}"
src="${WPA_GATE_SRC:-/opt/wpa/src}"
if [ ! -x "$venv" ]; then
	echo "wpa-grant-apply: $venv missing — run deploy/install.sh" >&2
	exit 1
fi
if [ ! -d "$src/wpa_mcp" ]; then
	echo "wpa-grant-apply: wpa_mcp missing under $src" >&2
	exit 1
fi

export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}"
exec "$venv" -m wpa_mcp.gateway_grant_cli apply
