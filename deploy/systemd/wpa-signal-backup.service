[Unit]
Description=Encrypted off-Pi backup of the Signal account state (NVB-9)
Documentation=https://github.com/NavehBrenner/whatsapp-pi-agent/blob/main/docs/runbooks/03-signal-cli.md
After=network-online.target
Wants=network-online.target
# A weekly unit latched into 'start-limit-hit' stops backing up and nothing says
# so until the day someone needs the backup.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Root: /var/lib/wpa-signal is 0700 wpa-signal, and this stops and starts
# signal-cli.service around the copy.

# The age recipient, the rclone remote, and the B2 application key. Root-owned,
# 0600, outside the repo — the repo is public and the key is live.
EnvironmentFile=/etc/wpa-signal-backup.env

# rclone is Go, and Go's built-in DNS resolver cannot resolve anything through
# this network's router (10.10.0.138): every lookup comes back "no such host"
# while glibc resolves the same name every time, verified on hardware 2026-08-11.
# netdns=cgo puts rclone on the same resolver as the rest of the system. Without
# it the backup fails weekly with what reads like a Backblaze outage.
Environment=GODEBUG=netdns=cgo

ExecStart=/usr/local/bin/wpa-signal-backup

# Both streams are sizes and paths, never account or message content.
StandardOutput=journal
StandardError=journal
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Reads the account state, writes the encrypted blobs. Nothing else.
# /var/backups and not /var/backups/wpa-signal: systemd sets up the mount
# namespace BEFORE ExecStart, so naming a directory the script has not created
# yet fails the unit with 226/NAMESPACE on a fresh install. Same trap as the
# StateDirectory= note in wpa-reader.service, from the other direction.
ReadWritePaths=/var/backups
ReadOnlyPaths=/var/lib/wpa-signal
