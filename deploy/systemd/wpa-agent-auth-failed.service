[Unit]
Description=Tell the owner in Signal that credential isolation is not holding
Documentation=https://github.com/NavehBrenner/whatsapp-pi-agent/blob/main/docs/runbooks/04-agent-deploy.md

[Service]
Type=oneshot
# Root, because the outbox is 0700 wpa-gate. Same shape as wpa-oc-auth-failed.
# The text is no longer inline here: wpa-triage reads this unit's journal and
# composes a message naming the cause and the command that fixes it, falling
# back to what this line used to say when nothing matches (NVB-41).
ExecStart=/usr/local/bin/wpa-triage wpa-agent-auth owner
