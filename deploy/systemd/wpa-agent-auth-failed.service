[Unit]
Description=Tell the owner in Signal that credential isolation is not holding
Documentation=https://github.com/NavehBrenner/whatsapp-pi-agent/blob/main/docs/runbooks/04-agent-deploy.md

[Service]
Type=oneshot
# Root, because the outbox is 0700 wpa-gate. Same shape as wpa-oc-auth-failed.
ExecStart=/usr/local/bin/wpa-outbox-notify owner "⚠️ Credential isolation is not holding on the Pi (NVB-32). Either `main` holds a profile — every agent without its own inherits it — or an agent has none of its own. Check: sudo /opt/wpa/deploy/check-agent-auth.sh"
