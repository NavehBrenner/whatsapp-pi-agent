[Unit]
Description=Tell the owner in Signal that the project mirror stopped updating
Documentation=https://github.com/NavehBrenner/whatsapp-pi-agent/blob/main/docs/runbooks/06-the-project-room.md

[Service]
Type=oneshot
# Root, because the outbox is 0700 wpa-gate. To the OWNER's chat: a stale mirror is
# exactly the failure the agent cannot notice on its own — the checkout still reads
# fine, it is merely old, so nothing in the room looks wrong.
# The text is no longer inline here: wpa-triage reads this unit's journal and
# composes a message naming the cause and the command that fixes it, falling
# back to what this line used to say when nothing matches (NVB-41).
# wpa-triage remembers which alerts it has already sent here, so a unit failing
# on a 60s timer pages once rather than sixty times an hour. Shared by every
# *-failed unit on purpose: one cause that breaks two units should be judged
# against one window, not two.
StateDirectory=wpa-triage
StateDirectoryMode=0700

ExecStart=/usr/local/bin/wpa-triage wpa-project-sync owner
