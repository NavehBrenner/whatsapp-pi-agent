[Unit]
Description=signal-cli JSON-RPC daemon (the assistant's Signal account, ADR 0004)
Documentation=https://github.com/NavehBrenner/whatsapp-pi-agent/blob/main/docs/runbooks/03-signal-cli.md
After=network-online.target
Wants=network-online.target
# A daemon latched into 'start-limit-hit' stops being retried and the control
# channel is simply gone, which looks like the assistant ignoring you.
StartLimitIntervalSec=0

[Service]
Type=simple
User=wpa-signal
Group=wpa-signal

# The assistant's number lives in /etc/wpa-signal.env, not in this file: the
# repo is public and there is no reason to publish a working number and invite
# traffic at it. Written by deploy/install-signal.sh.
EnvironmentFile=/etc/wpa-signal.env

# The JVM will take far more than it needs. Waydroid wants the 8GB, and the
# container now runs unfrozen, so cap it.
Environment=JAVA_OPTS=-Xmx256m

# --no-receive-stdout is not optional here. Without it the daemon prints every
# received message body to stdout, which under systemd means journald — verified
# on hardware 2026-08-11, the first test message landed in the log in plaintext.
# Messages still reach JSON-RPC clients; they just stop being logged.
# --scrub-log redacts identifiers from anything else it writes.
# --receive-mode on-connection, not on-start. With on-start the daemon pulls from
# Signal whether or not anything is listening, so a message arriving while the
# gate is restarting is acked to the server, dropped for lack of a subscriber, and
# gone — verified on hardware 2026-08-11, it does not replay on reconnect.
# on-connection makes the daemon fetch only while a client is attached, so those
# messages stay queued server-side and land when the gate comes back.
ExecStart=/usr/local/bin/signal-cli --scrub-log --config %S/wpa-signal -a ${ASSISTANT_NUMBER} \
    daemon --socket %t/wpa-signal/socket --receive-mode on-connection --no-receive-stdout

Restart=on-failure
RestartSec=10

# Holds the account's key material — this directory IS the account.
StateDirectory=wpa-signal
StateDirectoryMode=0700
RuntimeDirectory=wpa-signal
RuntimeDirectoryMode=0750
# 0007, not 0077: signal-cli creates the socket with this umask, and wpa-gate
# talks to it as a member of the wpa-signal group. It must be group-WRITABLE —
# connect(2) on a unix socket needs write permission, so 0027 (srwxr-x---) fails
# with EACCES and looks exactly like a socket that isn't there yet.
# Group membership buys the socket and nothing else: StateDirectoryMode below
# keeps /var/lib/wpa-signal — which is the account itself — at 0700, and a
# directory with no group execute bit cannot be traversed however its contents
# are moded.
UMask=0007

# Unlike the reader, this one legitimately needs the network — it is the control
# channel. Everything else still gets taken away.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# JSON-RPC is on a unix socket, so nothing listens on the network. Outbound to
# Signal only.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
